# Required. Encrypts stored database passwords. Generate your own:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
# To rotate: move the old key here (comma-separated), set a new APP_SECRET_KEY,
# start the API once so stored secrets are re-encrypted, then clear this line.
APP_SECRET_KEY_PREVIOUS=

PLATFORM_DATABASE_URL=
COMMERCE_ADMIN_URL=
MONGO_ADMIN_URL=

DEMO_PG_HOST=localhost
DEMO_PG_PORT=55432
DEMO_MONGO_HOST=localhost
DEMO_MONGO_PORT=27018
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
